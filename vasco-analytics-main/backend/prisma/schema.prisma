generator client {
  provider     = "prisma-client-js"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Equipe {
  id                    Int                  @id @default(autoincrement())
  nome                  String               @unique
  nomeCurto             String
  sigla                 String?
  cidade                String?
  estado                String?
  pais                  String               @default("Brasil")
  fundacao              DateTime?
  escudoUrl             String?
  criadoEm              DateTime             @default(now())
  estatisticas          EstatisticaEquipe[]
  estatisticasJogadores EstatisticaJogador[]
  eventos               EventoPartida[]
  jogadores             Jogador[]
  partidasCasa          Partida[]            @relation("EquipeCasa")
  partidasVisitante     Partida[]            @relation("EquipeVisitante")
  classificacoes        ClassificacaoEquipe[]
}

model Competicao {
  id        Int       @id @default(autoincrement())
  nome      String
  nomeCurto String?
  tipo      String?
  temporada String
  pais      String    @default("Brasil")
  criadoEm  DateTime  @default(now())
  partidas  Partida[]
  classificacao ClassificacaoEquipe[]

  @@unique([nome, temporada])
}

model Estadio {
  id           Int       @id @default(autoincrement())
  nome         String
  nomePopular  String?
  cidade       String
  estado       String?
  pais         String    @default("Brasil")
  capacidade   Int?
  inauguracao  DateTime?
  proprietario String?
  grama        String?
  fotoUrl      String?
  criadoEm     DateTime  @default(now())
  partidas     Partida[]
}

model Arbitro {
  id             Int                  @id @default(autoincrement())
  nomeCompleto   String
  nomePopular    String
  dataNascimento DateTime?
  nacionalidade  String               @default("Brasileiro")
  estado         String?
  fotoUrl        String?
  ativo          Boolean              @default(true)
  criadoEm       DateTime             @default(now())
  estatisticas   EstatisticaArbitro[]
  partidas       Partida[]
}

model Jogador {
  id                Int                  @id @default(autoincrement())
  equipeId          Int?
  nomeCompleto      String
  nomePopular       String
  nomeOriginal      String?
  dataNascimento    DateTime?
  nacionalidade     String?
  categoria         String               @default("Profissional")
  posicao           String?
  posicaoSecundaria String?
  numeroCamisa      Int?
  peDominante       String?
  alturaCm          Int?
  biografia         String?
  pesoKg            Float?
  fotoUrl           String?
  emprestado        Boolean              @default(false)
  tipoContrato      String               @default("DEFINITIVO")
  ativo             Boolean              @default(true)
  criadoEm          DateTime             @default(now())
  atualizadoEm      DateTime             @updatedAt
  origem            String               @default("Desconhecida")
  funcoes           String?
  clubeEmprestimo   String?
  estatisticas      EstatisticaJogador[]
  eventos           EventoPartida[]      @relation("JogadorPrincipal")
  eventosSecundario EventoPartida[]      @relation("JogadorSecundario")
  equipe            Equipe?              @relation(fields: [equipeId], references: [id])
  perfilFM          PerfilFM?

  @@unique([nomePopular, equipeId])
  @@index([equipeId])
  @@index([ativo])
}

model Partida {
  id                    Int                  @id @default(autoincrement())
  competicaoId          Int
  equipeCasaId          Int
  equipeVisitanteId     Int
  estadioId             Int?
  arbitroId             Int?
  treinadorCasaId       Int?
  treinadorVisitanteId  Int?
  dataHora              DateTime
  rodada                Int?
  fase                  String?
  golsCasa              Int?
  golsVisitante         Int?
  golsPenaltisCasa      Int?
  golsPenaltisVisitante Int?
  status                String               @default("agendada")
  publico               Int?
  criadoEm              DateTime             @default(now())
  eventId               Int?
  estatisticaArbitro    EstatisticaArbitro?
  estatisticasEquipes   EstatisticaEquipe[]
  estatisticasJogadores EstatisticaJogador[]
  eventos               EventoPartida[]
  arbitro               Arbitro?             @relation(fields: [arbitroId], references: [id])
  competicao            Competicao           @relation(fields: [competicaoId], references: [id])
  equipeCasa            Equipe               @relation("EquipeCasa", fields: [equipeCasaId], references: [id])
  equipeVisitante       Equipe               @relation("EquipeVisitante", fields: [equipeVisitanteId], references: [id])
  estadio               Estadio?             @relation(fields: [estadioId], references: [id])
  treinadorCasa         Treinador?           @relation("TreinadorCasa", fields: [treinadorCasaId], references: [id])
  treinadorVisitante    Treinador?           @relation("TreinadorVisitante", fields: [treinadorVisitanteId], references: [id])

  @@unique([equipeCasaId, equipeVisitanteId, dataHora])
  @@index([competicaoId])
  @@index([equipeCasaId])
  @@index([equipeVisitanteId])
  @@index([dataHora])
}

model EstatisticaJogador {
  id               Int      @id @default(autoincrement())
  partidaId        Int
  jogadorId        Int
  equipeId         Int
  titular          Boolean  @default(false)
  posicaoPartida   String?
  numeroCamisa     Int?
  posicaoMediaX    Float?
  posicaoMediaY    Float?
  heatmapUrl       String?
  minutosJogados   Int      @default(0)
  gols             Int      @default(0)
  assistencias     Int      @default(0)
  chutes           Int      @default(0)
  chutesGol        Int      @default(0)
  passesTentados   Int      @default(0)
  passesCompletos  Int      @default(0)
  driblesTentados  Int      @default(0)
  driblesCompletos Int      @default(0)
  desarmes         Int      @default(0)
  interceptacoes   Int      @default(0)
  faltasCometidas  Int      @default(0)
  faltasSofridas   Int      @default(0)
  cartoesAmarelos  Int      @default(0)
  cartoesVermelhos Int      @default(0)
  notaDesempenho   Float?
  criadoEm         DateTime @default(now())
  equipe           Equipe   @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  jogador          Jogador  @relation(fields: [jogadorId], references: [id], onDelete: Cascade)
  partida          Partida  @relation(fields: [partidaId], references: [id])

  @@unique([partidaId, jogadorId])
  @@index([jogadorId])
  @@index([equipeId])
  @@index([partidaId])
}

model EstatisticaEquipe {
  id               Int      @id @default(autoincrement())
  partidaId        Int
  equipeId         Int
  posseBola        Float?
  chutes           Int      @default(0)
  chutesGol        Int      @default(0)
  escanteios       Int      @default(0)
  faltas           Int      @default(0)
  impedimentos     Int      @default(0)
  passesTentados   Int      @default(0)
  passesCompletos  Int      @default(0)
  cartoesAmarelos  Int      @default(0)
  cartoesVermelhos Int      @default(0)
  criadoEm         DateTime @default(now())
  formacao         String?
  chutesFora       Int      @default(0)
  chutesNaTrave    Int      @default(0)
  defesasGoleiro   Int      @default(0)
  grandesChances   Int      @default(0)
  xG               Float?   @default(0)
  equipe           Equipe   @relation(fields: [equipeId], references: [id])
  partida          Partida  @relation(fields: [partidaId], references: [id])

  @@unique([partidaId, equipeId])
  @@index([partidaId])
  @@index([equipeId])
}

model EstatisticaArbitro {
  id                      Int      @id @default(autoincrement())
  arbitroId               Int
  partidaId               Int      @unique
  faltasMarcadas          Int      @default(0)
  cartoesAmarelos         Int      @default(0)
  cartoesVermelhos        Int      @default(0)
  penaltisMarcados        Int      @default(0)
  impedimentosAssinalados Int      @default(0)
  tempoBola               Int?
  acrescimos1t            Int      @default(0)
  acrescimos2t            Int      @default(0)
  criadoEm                DateTime @default(now())
  arbitro                 Arbitro  @relation(fields: [arbitroId], references: [id])
  partida                 Partida  @relation(fields: [partidaId], references: [id])

  @@unique([arbitroId, partidaId])
}

model EventoPartida {
  id                  Int      @id @default(autoincrement())
  partidaId           Int
  equipeId            Int
  jogadorId           Int?
  jogadorSecundarioId Int?
  tipoEvento          String
  minuto              Int
  minutoAcrescimo     Int      @default(0)
  descricao           String?
  criadoEm            DateTime @default(now())
  equipe              Equipe   @relation(fields: [equipeId], references: [id])
  jogador             Jogador? @relation("JogadorPrincipal", fields: [jogadorId], references: [id])
  jogadorSecundario   Jogador? @relation("JogadorSecundario", fields: [jogadorSecundarioId], references: [id])
  partida             Partida  @relation(fields: [partidaId], references: [id])

  @@index([partidaId])
  @@index([equipeId])
  @@index([jogadorId])
}

model Treinador {
  id                Int       @id @default(autoincrement())
  nome              String    @unique
  nacionalidade     String    @default("Brasileiro")
  criadoEm          DateTime  @default(now())
  partidasCasa      Partida[] @relation("TreinadorCasa")
  partidasVisitante Partida[] @relation("TreinadorVisitante")
}

model PerfilFM {
  id                Int      @id @default(autoincrement())
  jogadorId         Int      @unique
  cabeceamento      Int?
  chutesLonge       Int?
  cobrancaFalta     Int?
  cruzamento        Int?
  desarme           Int?
  drible            Int?
  escanteios        Int?
  finalizacao       Int?
  laterais          Int?
  marcacao          Int?
  passe             Int?
  penaltis          Int?
  primeiroToque     Int?
  tecnica           Int?
  agressividade     Int?
  antecipacao       Int?
  bravura           Int?
  compostura        Int?
  concentracao      Int?
  decisoes          Int?
  determinacao      Int?
  imprevisibilidade Int?
  indiceTrabalho    Int?
  lideranca         Int?
  posicionamento    Int?
  semBola           Int?
  trabalhoEquipe    Int?
  visaoJogo         Int?
  aceleracao        Int?
  agilidade         Int?
  aptidaoNatural    Int?
  equilibrio        Int?
  forca             Int?
  impulsao          Int?
  resistencia       Int?
  velocidade        Int?
  alcanceAereo      Int?
  comandoArea       Int?
  comunicacao       Int?
  excentricidade    Int?
  jogoMaos          Int?
  lancamentos       Int?
  reflexos          Int?
  reposicao         Int?
  saidaGol          Int?
  socos             Int?
  umContraUm        Int?
  atualizadoEm      DateTime @default(now()) @updatedAt
  jogador           Jogador  @relation(fields: [jogadorId], references: [id], onDelete: Cascade)
}

model ClassificacaoEquipe {
  id               Int        @id @default(autoincrement())
  competicaoId     Int
  equipeId         Int
  posicao          Int
  pontos           Int
  jogos            Int
  vitorias         Int
  empates          Int
  derrotas         Int
  golsPro          Int
  golsContra       Int
  saldoGols        Int
  atualizadoEm     DateTime   @default(now()) @updatedAt
  competicao       Competicao @relation(fields: [competicaoId], references: [id], onDelete: Cascade)
  equipe           Equipe     @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  @@unique([competicaoId, equipeId])
}

model Usuario {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  nome     String
  senha    String?
  role     Role     @default(USER)
  criadoEm DateTime @default(now())
  googleId String?  @unique
}

enum Role {
  USER
  ADMIN
}
